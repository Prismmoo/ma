# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Apps Script web-app endpoint. No Gmail password or Google secret belongs here.
# ⚠️ كل متغير يبدأ بـ VITE_ يُحقن داخل حزمة JavaScript العامة ويصبح مقروءاً للجميع.
# لا تضع فيه أي سر حقيقي. رابط Apps Script أدناه عمومي بحكم التصميم.
VITE_ORDER_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
