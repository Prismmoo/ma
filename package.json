{
  "name": "prism-gallery",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "audit": "npm audit --omit=dev --audit-level=high",
    "art:sync": "node scripts/sync-art-catalog.mjs",
    "art:verify": "node scripts/verify-art-urls.mjs",
    "report:bundle": "vite build && node scripts/report-bundle.mjs",
    "report:source": "node scripts/report-source.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@playwright/test": "1.60.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=20"
  }
}
